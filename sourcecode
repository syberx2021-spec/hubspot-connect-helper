// ==UserScript==
// @name         PTG Connect Helper (HubSpot + LinkedIn)
// @namespace    ptg-electronics
// @version      1.3.0
// @author       Patricia Camus (built with AI assistance from Claude by Anthropic)
// @description  HubSpot task queue -> LinkedIn connection request with the PTG note -> Complete -> Next. You press Enter to send every invite.
// @match        https://*.hubspot.com/*
// @match        https://www.linkedin.com/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_addValueChangeListener
// @grant        GM_setClipboard
// @grant        GM_registerMenuCommand
// @grant        GM_openInTab
// @noframes
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  /* ============================== SETTINGS ============================== */

  // Connection note. Free LinkedIn accounts allow 200 characters, Premium 300. This one is 148.
  const MESSAGE =
    'Hi! I work in BD at PTG Electronics, an EMS partner in the Midwest. ' +
    'We do PCBA, NPI, and box build for OEMs in your space. Would be good to connect.';

  // Your own email domain. LinkedIn's email box asks for the PROSPECT's email,
  // so an address on this domain is never typed into it.
  const OWN_EMAIL_DOMAIN = 'ptg-electronics.com';

  // How long "Already pending / connected" stays on screen before HubSpot is completed.
  const AUTO_COMPLETE_DELAY_MS = 1500;

  /* ===================================================================== */

  const VERSION = '1.3.0';
  const WORKER_NAME = 'PTG_LI_WORKER';
  const WORKER_HASH = 'ptg-worker';
  const TAB_ID = Math.random().toString(36).slice(2, 10);
  const KEY = {
    job: 'ptg_job',
    result: 'ptg_result',
    auto: 'ptg_auto',
    beat: 'ptg_worker_beat',
    ping: 'ptg_ping',
    pong: 'ptg_pong',
    claim: 'ptg_worker_claim',
    hs: 'ptg_hubspot_status',
  };
  const ON_HUBSPOT = /(^|\.)hubspot\.com$/.test(location.hostname);
  const ON_LINKEDIN = /(^|\.)linkedin\.com$/.test(location.hostname);

  // Mark the LinkedIn tab opened from HubSpot as the helper tab. Read at document-start,
  // before LinkedIn rewrites the URL; kept in sessionStorage for every page the tab loads.
  if (ON_LINKEDIN && location.hash.includes(WORKER_HASH)) {
    try { sessionStorage.setItem('ptg_worker', '1'); } catch (_) { /* ignore */ }
    window.name = WORKER_NAME;
  }

  /* ========================= PLAIN TEXT HELPERS ========================= */

  const clean = (s) => String(s == null ? '' : s).replace(/\s+/g, ' ').trim();
  const normName = (s) =>
    clean(String(s || '').normalize('NFKD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9 ]+/g, ' '));
  const ownDomainRe = new RegExp(`@([a-z0-9-]+\\.)*${OWN_EMAIL_DOMAIN.replace(/\./g, '\\.')}$`, 'i');
  const isOwnEmail = (e) => ownDomainRe.test(clean(e));
  const EMAIL_RE = /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi;

  // Any LinkedIn profile link -> https://www.linkedin.com/in/<slug>/ (country subdomains, no protocol,
  // tracking parameters and trailing punctuation all handled). Sales Navigator links are kept as they are.
  function normalizeLinkedInUrl(raw) {
    if (!raw) return null;
    let s = clean(raw).replace(/[)\].,;'"]+$/, '');
    if (!/^https?:\/\//i.test(s)) s = `https://${s.replace(/^\/+/, '')}`;
    let u;
    try { u = new URL(s); } catch (_) { return null; }
    if (!/(^|\.)linkedin\.com$/i.test(u.hostname)) return null;
    const path = u.pathname.replace(/\/{2,}/g, '/');
    const inMatch = path.match(/^\/in\/([^/]+)/i);
    if (inMatch) return `https://www.linkedin.com/in/${inMatch[1]}/`;
    if (/^\/pub\/[^/]+/i.test(path)) return `https://www.linkedin.com${path}`;
    if (/^\/sales\/(lead|people)\//i.test(path)) return `https://www.linkedin.com${path}${u.search}`;
    return null;
  }

  function slugOf(url) {
    try {
      const path = decodeURIComponent(new URL(url, 'https://www.linkedin.com').pathname).toLowerCase();
      const m = path.match(/\/(?:in|pub)\/([^/]+)/);
      return m ? m[1] : null;
    } catch (_) { return null; }
  }

  // "Task 2/324", "Task2/324", "Task 2 of 324"
  function parseTaskLabel(text) {
    const m = clean(text).match(/^task\s*(\d+)\s*(?:\/|of)\s*(\d+)$/i);
    return m ? { n: +m[1], m: +m[2], text: `Task ${m[1]}/${m[2]}` } : null;
  }

  function limitKind(text) {
    const t = clean(text).toLowerCase();
    if (/(close to|approaching|nearing|almost (at|reached)) (the |your )?weekly (invitation |invite )?limit/.test(t)) return 'close';
    if (/weekly (invitation |invite )?limit|invitation limit|out of invitations|no (more )?invitations left|too many pending invitations/.test(t)) return 'reached';
    return null;
  }

  const noteQuotaHit = (text) =>
    /personali[sz]ed (invitation|invite|note)s?/i.test(text) &&
    /(used|out of|no more|left|remaining|this month|premium|unlimited)/i.test(text);

  /* ============================ DOM HELPERS ============================= */

  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const textOf = (el) => clean(el ? el.textContent : '');
  const ariaOf = (el) => ((el && el.getAttribute && el.getAttribute('aria-label')) || '').toLowerCase();
  const ours = (el) => !!(el && el.closest && el.closest('#ptg-helper'));
  const autoOn = () => !!GM_getValue(KEY.auto, false);
  const rectOf = (el) => el.getBoundingClientRect();
  const isDisabled = (b) => !!b && (!!b.disabled || b.getAttribute('aria-disabled') === 'true');

  // Visible text of an element, leaving out icon titles inside <svg>.
  function ownText(el) {
    if (!el) return '';
    let s = '';
    const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    let n;
    while ((n = w.nextNode())) if (!(n.parentElement && n.parentElement.closest('svg'))) s += n.nodeValue;
    return clean(s);
  }

  // Each text node on its own. HubSpot puts a label and its value in neighbouring boxes with no
  // space between them, so joining textContent would glue "Email" onto the address.
  function textPieces(el) {
    const out = [];
    if (!el) return out;
    const w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    let n;
    while ((n = w.nextNode())) { const v = clean(n.nodeValue); if (v && !ours(n.parentElement)) out.push(v); }
    return out;
  }

  // The button, link or menu item someone would actually click for `el`.
  function actionable(el) {
    const SEL = 'button, a[href], [role="button"], [role="menuitem"]';
    if (el.matches && el.matches(SEL)) return el;
    return (el.querySelector && [...el.querySelectorAll(SEL)].find(isVisible)) || el.closest(SEL) || el;
  }

  // Accessible hints on an icon button: aria-label, title, and the icon's own label or name.
  function hintsOf(el) {
    if (!el || !el.getAttribute) return '';
    const parts = [el.getAttribute('aria-label'), el.getAttribute('title')];
    for (const x of el.querySelectorAll('svg, title, [aria-label], [data-icon-name], [data-test-icon]')) {
      if (x.tagName.toLowerCase() === 'title') parts.push(x.textContent);
      parts.push(x.getAttribute('aria-label'), x.getAttribute('data-icon-name'), x.getAttribute('data-test-icon'));
    }
    return clean(parts.filter(Boolean).join(' ')).toLowerCase();
  }

  function isVisible(el) {
    if (!el || !el.isConnected || !el.getClientRects().length) return false;
    return el.checkVisibility ? el.checkVisibility({ checkVisibilityCSS: true, visibilityProperty: true }) : true;
  }

  // Elements whose own text node passes `test(rawText)`.
  function textNodes(root, test) {
    const out = [];
    if (!root) return out;
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: (n) => (test(n.nodeValue || '') ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP),
    });
    let n;
    while ((n = walker.nextNode())) if (n.parentElement && !ours(n.parentElement)) out.push(n.parentElement);
    return out;
  }

  // Resolves with fn()'s first truthy value. Re-checks on page changes as well as on a timer,
  // so it stays quick even when Chrome slows down timers in a background tab.
  function waitFor(fn, timeout = 10000, every = 250) {
    return new Promise((resolve) => {
      let done = false;
      let pending = null;
      let last = 0;
      let poll = null;
      let timer = null;
      const observer = new MutationObserver(() => {
        if (done || pending) return;
        pending = setTimeout(() => { pending = null; check(); }, Math.max(0, 80 - (Date.now() - last)));
      });
      const finish = (v) => {
        if (done) return;
        done = true;
        observer.disconnect();
        clearInterval(poll);
        clearTimeout(timer);
        clearTimeout(pending);
        resolve(v);
      };
      function check() {
        if (done) return;
        last = Date.now();
        let v = null;
        try { v = fn(); } catch (_) { v = null; }
        if (v) finish(v);
      }
      observer.observe(document.documentElement, { childList: true, subtree: true, attributes: true, characterData: true });
      poll = setInterval(check, every);
      timer = setTimeout(() => { check(); finish(null); }, timeout);
      check();
    });
  }

  // Press-and-release without the final click. Some menus open on pointer-down only.
  function pointerSeq(el) {
    const r = rectOf(el);
    const o = { bubbles: true, cancelable: true, composed: true, button: 0, buttons: 1, clientX: r.left + r.width / 2, clientY: r.top + r.height / 2 };
    try { el.dispatchEvent(new PointerEvent('pointerdown', { ...o, pointerType: 'mouse', isPrimary: true })); } catch (_) { /* ignore */ }
    el.dispatchEvent(new MouseEvent('mousedown', o));
    try { el.dispatchEvent(new PointerEvent('pointerup', { ...o, buttons: 0, pointerType: 'mouse', isPrimary: true })); } catch (_) { /* ignore */ }
    el.dispatchEvent(new MouseEvent('mouseup', { ...o, buttons: 0 }));
  }

  function pressKey(el, key) {
    const o = { key, code: key, bubbles: true, cancelable: true, composed: true };
    el.dispatchEvent(new KeyboardEvent('keydown', o));
    el.dispatchEvent(new KeyboardEvent('keyup', o));
  }

  // Try a plain click first; if nothing happens, a pointer press, then the keyboard.
  // Each step only runs if the one before it changed nothing, so nothing gets clicked twice.
  async function activate(el, done, firstWait = 1200, laterWait = firstWait) {
    el.click();
    let v = await waitFor(done, firstWait);
    if (v || !el.isConnected) return v;
    pointerSeq(el);
    v = await waitFor(done, laterWait);
    if (v || !el.isConnected) return v;
    try { el.focus(); pressKey(el, 'Enter'); } catch (_) { /* ignore */ }
    return waitFor(done, laterWait);
  }

  // Types into React-controlled inputs so the page notices the change.
  function fillText(box, value) {
    box.focus();
    try { box.select(); } catch (_) { /* some input types can't select */ }
    let ok = false;
    try { ok = document.execCommand('insertText', false, value); } catch (_) { /* fall through */ }
    if (!ok || box.value !== value) {
      const proto = box instanceof HTMLInputElement ? HTMLInputElement.prototype : HTMLTextAreaElement.prototype;
      Object.getOwnPropertyDescriptor(proto, 'value').set.call(box, value);
      box.dispatchEvent(new Event('input', { bubbles: true }));
      box.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  function hotkeys(map) {
    document.addEventListener('keydown', (e) => {
      if (!e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const act = map[e.code];
      if (!act) return;
      e.preventDefault();
      e.stopPropagation();
      act();
    }, true);
  }

  /* =============================== PANEL =============================== */

  // Solder-mask green with copper accents, so it never blends into HubSpot or LinkedIn.
  const CSS = `
#ptg-helper{all:initial;position:fixed;bottom:18px;z-index:2147483647;width:280px;box-sizing:border-box;
  background:#0F3A2C;color:#E9F1EA;border:1px solid #1E5A45;border-radius:8px;
  box-shadow:0 10px 30px rgba(4,20,14,.45);font:12.5px/1.45 "Segoe UI",system-ui,-apple-system,sans-serif}
#ptg-helper *{box-sizing:border-box;font:inherit;color:inherit;letter-spacing:normal;text-transform:none}
#ptg-helper.ptg-right{right:92px}
#ptg-helper.ptg-left{left:18px}
#ptg-helper .ptg-head{display:flex;align-items:center;justify-content:space-between;padding:7px 8px 7px 12px;border-bottom:1px solid #1E5A45}
#ptg-helper .ptg-title{font-weight:600;color:#D9A066}
#ptg-helper .ptg-min{all:unset;cursor:pointer;width:22px;height:22px;line-height:22px;text-align:center;border-radius:4px;color:#B7CDBF}
#ptg-helper .ptg-min:hover{background:#174A39}
#ptg-helper .ptg-body{padding:10px 12px 12px}
