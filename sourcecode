#ptg-helper .ptg-mirror .ptg-dot{width:7px;height:7px;transform:translateY(-1px)}
`;

  function makePanel(side) {
    const style = document.createElement('style');
    style.id = 'ptg-helper-style';
    style.textContent = CSS;
    (document.head || document.documentElement).appendChild(style);

    const box = document.createElement('div');
    box.id = 'ptg-helper';
    box.className = side === 'left' ? 'ptg-left' : 'ptg-right';
    box.innerHTML = `
      <div class="ptg-head"><span class="ptg-title" title="Version ${VERSION}">PTG connect helper</span><button type="button" class="ptg-min" title="Minimize">–</button></div>
      <div class="ptg-body">
        <div class="ptg-status" data-tone="work"><span class="ptg-dot"></span><span class="ptg-msg">Starting…</span></div>
        <div class="ptg-sub"></div>
        <label class="ptg-auto"><input type="checkbox"><span>Auto mode</span></label>
        <div class="ptg-btns"></div>
        <div class="ptg-keys"></div>
        <div class="ptg-mirror" data-tone="ok"><span class="ptg-dot"></span><span class="ptg-mirror-msg"></span></div>
      </div>`;
    document.body.appendChild(box);

    const $ = (s) => box.querySelector(s);
    const auto = $('.ptg-auto input');
    auto.checked = autoOn();
    auto.addEventListener('change', () => GM_setValue(KEY.auto, auto.checked));
    GM_addValueChangeListener(KEY.auto, (_k, _o, v) => { auto.checked = !!v; });

    const minKey = `ptg_min_${side}`;
    const applyMin = (m) => { box.classList.toggle('ptg-collapsed', !!m); $('.ptg-min').textContent = m ? '+' : '–'; };
    applyMin(GM_getValue(minKey, false));
    $('.ptg-min').addEventListener('click', () => {
      const m = !box.classList.contains('ptg-collapsed');
      GM_setValue(minKey, m);
      applyMin(m);
    });

    return {
      el: box,
      // tone: ok (green), work (green, pulsing), warn (amber), err (red)
      set(tone, msg, next = '') {
        $('.ptg-status').dataset.tone = tone;
        $('.ptg-msg').textContent = msg;
        $('.ptg-sub').textContent = next || '';
      },
      mirror(tone, msg) {
        const m = $('.ptg-mirror');
        m.classList.toggle('ptg-on', !!msg);
        m.dataset.tone = tone || 'ok';
        $('.ptg-mirror-msg').textContent = msg ? `HubSpot: ${msg}` : '';
      },
      button(label, fn) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.addEventListener('click', fn);
        $('.ptg-btns').appendChild(b);
      },
      keys(pairs) {
        const k = $('.ptg-keys');
        k.textContent = '';
        for (const [key, what] of pairs) {
          const kbd = document.createElement('kbd');
          kbd.textContent = key;
          const span = document.createElement('span');
          span.textContent = what;
          k.append(kbd, span);
        }
      },
      keepAttached() {
        if (!style.isConnected) (document.head || document.documentElement).appendChild(style);
        if (!box.isConnected) document.body.appendChild(box);
      },
    };
  }

  /* ============================== HUBSPOT ============================== */

  function runHubSpot() {
    if (!/^app/.test(location.hostname)) return; // only the HubSpot app, not help or marketing sites
    console.info(`[PTG connect helper ${VERSION}] loaded on HubSpot`);
    const ui = makePanel('right');
    const say = (tone, msg, next = '') => {
      ui.set(tone, msg, next);
      try { GM_setValue(KEY.hs, { tone, msg, next, at: Date.now() }); } catch (_) { /* ignore */ }
    };
    ui.button('Open LinkedIn', () => sendJob(true));
    ui.button('Complete & next', () => run(completeAndNext));
    ui.button('Back', () => run(goBack));
    ui.button('Skip', () => run(skipToNext));
    ui.keys([
      ['Alt+L', 'Open LinkedIn profile'],
      ['Alt+X', 'Complete & next'],
      ['Alt+B', 'Back to previous task'],
      ['Alt+S', 'Skip to next'],
    ]);

    let currentUrl = null;
    let prevUrl = null;
    let lastKey = '';
    let busy = false;
    let token = 0;
    let inQueue = false;
    let reviewing = false; // true after Back: Auto stays off so you can check
    let flag = ''; // 'nourl' | 'same'

    async function run(fn) {
      if (busy) return false;
      busy = true;
      try { await fn(); return true; } finally { busy = false; }
    }

    /* ---------- reading the task ---------- */

    function findTaskLabel() {
      const hits = textNodes(document.body, (raw) => /\d\s*(?:\/|of)\s*\d/i.test(raw));
      for (const start of hits) {
        let el = start;
        for (let i = 0; i < 3 && el && el !== document.body; i++, el = el.parentElement) {
          const t = textOf(el);
          if (t.length > 30) break;
          if (parseTaskLabel(t) && isVisible(el)) return el;
        }
      }
      return null;
    }
    function labelInfo() {
      const el = findTaskLabel();
      const p = el && parseTaskLabel(textOf(el));
      return p ? { el, ...p } : null;
    }
    function taskId() {
      for (const [k, v] of new URLSearchParams(location.search)) if (/task|engagement/i.test(k) && /^\d+$/.test(v)) return v;
      return null;
    }
    const recordId = () => (location.pathname.split('/').filter((s) => /^\d+$/.test(s)).pop() || '');
    const taskKey = () => `${taskId() || '-'}|${recordId() || '-'}|${(labelInfo() || {}).n || '-'}`;

    function keyInfoRoot() {
      for (const h of textNodes(document.body, (raw) => /^\s*key information\s*$/i.test(raw))) {
        if (!isVisible(h)) continue;
        let el = h;
        for (let i = 0; i < 5 && el && el !== document.body; i++, el = el.parentElement) {
          if (textOf(el).length > 60) return el;
        }
      }
      return null;
    }

    const LI_LABEL = /^\s*linked\s*in(\s+(profile|personal))?(\s+(url|link|bio|page|profile))?\s*:?\s*$/i;
    function urlFrom(el) {
      for (const a of el.querySelectorAll('a[href]')) {
        if (ours(a)) continue;
        const u = normalizeLinkedInUrl(a.href);
        if (u) return u;
      }
      for (const t of textPieces(el)) {
        const m = t.match(/(?:https?:\/\/)?(?:[\w-]+\.)?linkedin\.com\/(?:in|pub)\/[^\s"'<>]+/i);
        const u = m && normalizeLinkedInUrl(m[0]);
        if (u) return u;
      }
      return null;
    }
    function findLinkedInUrl() {
      const info = keyInfoRoot();
      for (const root of [info, document.body]) {
        if (!root) continue;
        for (const lab of textNodes(root, (raw) => LI_LABEL.test(raw))) {
          if (!isVisible(lab)) continue;
          let el = lab;
          for (let i = 0; i < 5 && el && el !== document.body; i++, el = el.parentElement) {
            const u = urlFrom(el);
            if (u) return u;
          }
        }
      }
      if (info) { const u = urlFrom(info); if (u) return u; }
      for (const a of document.querySelectorAll('a[href*="linkedin.com"]')) {
        if (ours(a) || !isVisible(a)) continue;
        const u = normalizeLinkedInUrl(a.href);
        if (u) return u;
      }
      return null;
    }

    // The PROSPECT's email from the contact card. Your own @ptg-electronics.com address is never used.
    function findContactEmail() {
      const info = keyInfoRoot();
      const pick = (text) => (clean(text).match(EMAIL_RE) || []).find((e) => !isOwnEmail(e)) || null;
      const pickIn = (el) => textPieces(el).map(pick).find(Boolean) || null;
      for (const root of [info, document.body]) {
        if (!root) continue;
        for (const lab of textNodes(root, (raw) => /^\s*(e-?mail|email address)\s*:?\s*$/i.test(raw))) {
          let el = lab;
          for (let i = 0; i < 4 && el && el !== document.body; i++, el = el.parentElement) {
            const found = pickIn(el);
            if (found) return found;
          }
        }
      }
      const exact = textNodes(document.body, (raw) => /^\s*[^\s@]+@[^\s@]+\.[a-z]{2,}\s*$/i.test(raw))
        .filter(isVisible)
        .map((el) => pick(el.textContent))
        .find(Boolean);
      if (exact) return exact;
      for (const a of document.querySelectorAll('a[href^="mailto:"]')) {
        const e = pick(decodeURIComponent(a.getAttribute('href').slice(7).split('?')[0]));
        if (e) return e;
      }
      return null;
    }

    /* ---------- Complete and the ‹ › arrows ---------- */

    const COMPLETE_RE = /^(mark (as )?)?complete( task)?$/i;
    const DONE_RE = /^(completed|task completed|mark (as )?(incomplete|not complete(d)?)|reopen( task)?|undo complete)$/i;
    const visibleButtons = () => [...document.querySelectorAll('button, [role="button"]')].filter((b) => !ours(b) && isVisible(b));
    const matches = (b, re) => re.test(ownText(b)) || re.test(b.getAttribute('aria-label') || '') || re.test(b.getAttribute('title') || '');

    function completeButton() {
      return visibleButtons().filter((b) => matches(b, COMPLETE_RE)).sort((a, z) => rectOf(a).top - rectOf(z).top)[0] || null;
    }
    function completeButtonNear(where) {
      return visibleButtons().some((b) => {
        if (!matches(b, COMPLETE_RE)) return false;
        const r = rectOf(b);
        return Math.abs(r.top - where.top) < 40 && Math.abs(r.left - where.left) < 120;
      });
    }
    // A "Completed" / "Reopen" state right where the Complete button was (never the timeline further down).
    function doneIndicator(where) {
      if (!where) {
        const lab = findTaskLabel();
        if (!lab) return null;
        where = rectOf(lab);
      }
      const close = (r) => Math.abs(r.top - where.top) < 120 && Math.abs(r.left - where.left) < 500;
      const btn = visibleButtons().find((b) => matches(b, DONE_RE) && close(rectOf(b)));
      if (btn) return btn;
      return textNodes(document.body, (raw) => /^\s*(completed|task completed)\s*$/i.test(raw))
        .find((el) => isVisible(el) && close(rectOf(el))) || null;
    }
    const toastDone = () =>
      [...document.querySelectorAll('[role="alert"], [role="status"]')]
        .some((t) => !ours(t) && isVisible(t) && /task.{0,40}(complete|done)|marked as complete/i.test(textOf(t)));

    const PREV_RE = /prev|previous|back|left|earlier/i;
    const NEXT_RE = /next|forward|right|later/i;
    const NOT_ARROW = /close|dismiss|exit|setting|more|option|edit|filter|complete|skip|menu|search|help|expand|collapse|minimi|maximi|copy|call|mail|note/i;

    // The ‹ › arrows next to "Task N/M" are icon-only, so they're found by position (either side of the
    // label), helped by their aria-label or icon name when HubSpot provides one.
    function navArrows() {
      const info = labelInfo();
      if (!info) return null;
      const r = rectOf(info.el);
      const midY = r.top + r.height / 2;
      const nameOf = (b) => `${hintsOf(b)} ${ownText(b)}`;
      const near = visibleButtons()
        .map((b) => ({ b, r: rectOf(b) }))
        .filter(({ b, r: br }) => {
          if (!br.width || br.width > 64 || br.height > 64) return false;
          if (br.top > midY + 6 || br.bottom < midY - 6) return false;
          const gap = br.left >= r.right - 4 ? br.left - r.right : r.left - br.right;
          if (gap > 160) return false;
          const own = ownText(b);
          if (own.length > 1) return false;
          const name = nameOf(b);
          return !(NOT_ARROW.test(name) && !PREV_RE.test(name) && !NEXT_RE.test(name));
        });
      const isPrev = (x) => PREV_RE.test(nameOf(x.b)) || /^[‹<←]$/.test(ownText(x.b));
      const isNext = (x) => NEXT_RE.test(nameOf(x.b)) || /^[›>→]$/.test(ownText(x.b));
      let prev = near.find((x) => isPrev(x) && !isNext(x)) || null;
      let next = near.find((x) => isNext(x) && !isPrev(x)) || null;
      if (!prev || !next) {
        const rest = near.filter((x) => x !== prev && x !== next);
        const left = rest.filter((x) => x.r.right <= r.left + 4).sort((a, z) => z.r.right - a.r.right); // closest first
        const right = rest.filter((x) => x.r.left >= r.right - 4).sort((a, z) => a.r.left - z.r.left); // closest first
        const pair = (a, z) => z.r.left - a.r.right < 32;
        if (!prev && !next) {
          if (left.length && right.length) { prev = left[0]; next = right[0]; }
          else if (right.length >= 2 && pair(right[0], right[1])) { prev = right[0]; next = right[1]; }
          else if (left.length >= 2 && pair(left[1], left[0])) { prev = left[1]; next = left[0]; }
          else if (rest.length === 1 && info.n === 1) next = rest[0];
          else if (rest.length === 1 && info.n === info.m) prev = rest[0];
        } else if (!next) {
          next = right.find((x) => x.r.left >= prev.r.right - 4) || null;
        } else {
          prev = left.find((x) => x.r.right <= next.r.left + 4) || right.find((x) => x.r.right <= next.r.left + 4) || null;
        }
      }
      if (prev && next && prev.b === next.b) return null;
      return prev || next ? { prev: prev ? prev.b : null, next: next ? next.b : null } : null;
    }

    async function clickArrow(which, startKey) {
      const btn = await waitFor(() => {
        const a = navArrows();
        const b = a && a[which];
        return b && !isDisabled(b) ? b : null;
      }, which === 'next' ? 5000 : 3000);
      if (!btn) return 'none';
      const moved = await activate(btn, () => taskKey() !== startKey, 4000, 6000);
      return moved ? 'moved' : 'stuck';
    }

    /* ---------- the LinkedIn helper tab ---------- */

    const pongWaiters = new Map();
    GM_addValueChangeListener(KEY.pong, (_k, _o, v, remote) => {
      if (!remote || !v || !pongWaiters.has(v.id)) return;
      pongWaiters.get(v.id)(true);
      pongWaiters.delete(v.id);
    });
    function ping(ms) {
      const id = Math.random().toString(36).slice(2);
      return new Promise((resolve) => {
        const t = setTimeout(() => { pongWaiters.delete(id); resolve(false); }, ms);
        pongWaiters.set(id, (v) => { clearTimeout(t); resolve(v); });
        GM_setValue(KEY.ping, { id, at: Date.now() });
      });
    }
    function beatFresh() {
      const b = GM_getValue(KEY.beat, null);
      const at = typeof b === 'number' ? b : b && b.at;
      return !!at && Date.now() - at < 12000;
    }
    function openHelper(url) {
      const target = `${(url || 'https://www.linkedin.com/feed/').split('#')[0]}#${WORKER_HASH}`;
      let w = null;
      try { w = window.open(target, WORKER_NAME); } catch (_) { /* blocked */ }
      if (!w) { try { GM_openInTab(target, { active: true, setParent: true }); } catch (_) { /* ignore */ } }
    }

    async function sendJob(fromClick) {
      const info = labelInfo();
      if (!info) {
        if (!fromClick) return;
        if (beatFresh() || (await ping(700))) {
          say('ok', 'LinkedIn helper tab is open', 'Start your task queue, then press Alt+L.');
        } else {
          openHelper(null);
          say('ok', 'Opened the LinkedIn helper tab', 'Keep it open. Start your task queue, then press Alt+L.');
        }
        return;
      }
      if (!currentUrl) currentUrl = findLinkedInUrl();
      if (!currentUrl) {
        say('warn', `${info.text}: no LinkedIn URL`, 'Do this one by hand, then Alt+X (complete) or Alt+S (skip).');
        return;
      }
      const email = findContactEmail();
      const job = {
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        url: currentUrl,
        slug: slugOf(currentUrl),
        email,
        key: taskKey(),
        label: info.text,
        at: Date.now(),
      };
      let alive = beatFresh() || (await ping(fromClick ? 700 : 1200));
      GM_setValue(KEY.job, job);
      if (!alive && fromClick) { openHelper(currentUrl); alive = true; }
      if (!alive) {
        say('warn', `${info.text}: LinkedIn helper tab isn’t open`, 'Click “Open LinkedIn” once to open it.');
        return;
      }
      flag = '';
      say('ok', `${info.text}: opened on LinkedIn`, email ? currentUrl : `${currentUrl} (no email in HubSpot)`);
    }

    /* ---------- moving through the queue ---------- */

    const kick = () => setTimeout(tick, 60);

    async function onTaskChange() {
      const mine = ++token;
      if (currentUrl) prevUrl = currentUrl;
      currentUrl = null;
      flag = '';
      const label = (labelInfo() || {}).text || 'Task';
      say('work', `${label}: loading…`, 'Reading the contact’s LinkedIn link.');
      await sleep(700);
      let url = await waitFor(() => { const u = findLinkedInUrl(); return u && u !== prevUrl ? u : null; }, 6000);
      if (mine !== token) return;
      let same = false;
      if (!url) { url = findLinkedInUrl(); same = !!url && url === prevUrl; }
      currentUrl = url;
      if (!url) {
        flag = 'nourl';
        say('warn', `${label}: no LinkedIn URL`, 'Do this one by hand, then Alt+X (complete) or Alt+S (skip).');
        return;
      }
      if (reviewing) {
        say('warn', `${label}: checking (Auto paused)`, 'Alt+L to view them on LinkedIn. Turn Auto back on to continue from here.');
        return;
      }
      if (same) {
        flag = 'same';
        say('warn', `${label}: same LinkedIn as the last task`, 'Make sure the contact loaded, then press Alt+L to open it.');
        return;
      }
      say('ok', `${label}: ready`, autoOn() ? 'Opening on LinkedIn…' : 'Press Alt+L to open them on LinkedIn.');
      if (autoOn()) sendJob(false);
    }

    async function goNext(startKey) {
      const info = labelInfo();
      say('work', 'Going to the next task…', '');
      const res = await clickArrow('next', startKey);
      if (res === 'moved') { kick(); return; }
      if (res === 'none' && info && info.n === info.m) {
        GM_setValue(KEY.auto, false);
        say('ok', 'End of the queue', 'Every task is done. Auto mode is off.');
        return;
      }
      if (res === 'none') {
        say('err', 'Couldn’t find the › arrow', `Click › next to “${info ? info.text : 'Task N/M'}” yourself.`);
        return;
      }
      say('err', 'The next task didn’t load', 'Check HubSpot. When the next task is open, press Alt+L.');
    }

    async function goBack() {
      if (autoOn()) GM_setValue(KEY.auto, false);
      reviewing = true;
      say('work', 'Going back…', 'Auto mode is paused so you can check.');
      const res = await clickArrow('prev', taskKey());
      if (res === 'moved') { kick(); return; }
      if (res === 'none') say('warn', 'No previous task', 'This is the first task. Turn Auto on to continue from here.');
      else say('err', 'The previous task didn’t load', 'Check HubSpot, then press Alt+L to open the task on LinkedIn.');
    }

    async function skipToNext() {
      say('work', 'Skipping…', 'Moving on without completing this task.');
      await goNext(taskKey());
    }

    async function completeAndNext() {
      const startKey = taskKey();
      const label = (labelInfo() || {}).text || 'Task';
      say('work', `${label}: completing…`, 'Clicking Complete in HubSpot.');
      const btn = await waitFor(() => { const b = completeButton(); return b && !isDisabled(b) ? b : null; }, 3000);
      if (!btn) {
        if (!doneIndicator()) {
          const grey = completeButton();
          say('err', grey ? 'Complete is greyed out' : 'Complete button not found', 'Click Complete in HubSpot yourself, then Alt+S to move on.');
          return;
        }
        // Already completed: just move on.
      } else {
        const where = rectOf(btn);
        const t0 = Date.now();
        let disabledSince = 0;
        btn.click();
        const ok = await waitFor(() => {
          if (taskKey() !== startKey || doneIndicator(where) || toastDone()) return true;
          if (btn.isConnected && isVisible(btn) && !matches(btn, COMPLETE_RE)) return true; // label changed
          if (isDisabled(btn)) { disabledSince = disabledSince || Date.now(); if (Date.now() - disabledSince > 1500) return true; } else disabledSince = 0;
          return Date.now() - t0 > 800 && !completeButtonNear(where); // the button went away
        }, 8000);
        if (!ok) {
          say('err', 'HubSpot didn’t confirm Complete', 'Check the task, then Alt+X to try again or Alt+S to move on.');
          return;
        }
        if (taskKey() !== startKey) { kick(); return; } // HubSpot moved on by itself
        await sleep(600);
      }
      await goNext(startKey);
    }

    /* ---------- results from the LinkedIn tab ---------- */

    GM_addValueChangeListener(KEY.result, async (_k, _o, res, remote) => {
      if (!remote || !res) return;
      const job = GM_getValue(KEY.job, null);
      if (!job || res.jobId !== job.id) return; // an older task
      if (res.status === 'stop') {
        say('err', 'LinkedIn invite limit reached', 'Auto mode is off. Stop sending until LinkedIn resets your limit.');
        return;
      }
      if (res.auto && (!autoOn() || reviewing)) {
        say('warn', `${job.label || 'Task'}: not completed`, 'Auto mode is off. Press Alt+X if it should be completed.');
        return;
      }
      if (busy) await waitFor(() => !busy, 15000);
      if (res.status === 'back') { run(goBack); return; }
      if (job.key !== taskKey()) {
        say('warn', 'HubSpot is on a different task now', `LinkedIn’s answer was for ${job.label || 'another task'}. Check it, then Alt+X or Alt+S.`);
        return;
      }
      if (res.status === 'skip') run(skipToNext);
      else run(completeAndNext);
    });

    // Turning Auto on (in either panel) ends review and sends the current task to LinkedIn.
    GM_addValueChangeListener(KEY.auto, (_k, _o, on) => {
      if (!on) return;
      const wasReviewing = reviewing;
      reviewing = false;
      if (!inQueue || busy || !currentUrl || (flag === 'same' && !wasReviewing)) return;
      const label = (labelInfo() || {}).text || 'Task';
      say('ok', `${label}: ready`, 'Opening on LinkedIn…');
      sendJob(false);
    });

    hotkeys({
      KeyL: () => sendJob(true),
      KeyX: () => { if (inQueue) run(completeAndNext); },
      KeyS: () => { if (inQueue) run(skipToNext); },
      KeyB: () => { if (inQueue) run(goBack); },
    });

    function tick() {
      ui.keepAttached();
      inQueue = !!findTaskLabel() || !!taskId();
      if (!inQueue) {
        // The panel stays visible on every HubSpot page so you can tell the script is running.
        if (lastKey !== 'idle') {
          lastKey = 'idle';
          currentUrl = null;
          prevUrl = null;
          say('ok', 'Waiting for the task queue', 'Go to Tasks and click “Start tasks”.');
        }
        return;
      }
      const key = taskKey();
      if (key !== lastKey) { lastKey = key; onTaskChange(); }
    }

    let tickTimer = null;
    new MutationObserver(() => {
      if (!tickTimer) tickTimer = setTimeout(() => { tickTimer = null; tick(); }, 400);
    }).observe(document.body, { childList: true, subtree: true, characterData: true });
    setInterval(tick, 1000);
    tick();
  }

  /* ============================== LINKEDIN ============================= */

  function runLinkedIn() {
    GM_registerMenuCommand('Use this tab for PTG connect helper', () => {
      try { sessionStorage.setItem('ptg_worker', '1'); } catch (_) { /* ignore */ }
      window.name = WORKER_NAME;
      location.reload();
    });

    const isWorker = () => {
      try { if (sessionStorage.getItem('ptg_worker') === '1') return true; } catch (_) { /* ignore */ }
      return window.name === WORKER_NAME;
    };
    if (!isWorker()) return; // only the helper tab gets the panel
    console.info(`[PTG connect helper ${VERSION}] loaded on LinkedIn (helper tab)`);

    const LABEL = {
      sent: 'Invite sent',
      pending: 'Already pending',
      connected: 'Already connected',
      done: 'Marked done',
      skip: 'Skipped',
      back: 'Going back',
    };

    const ui = makePanel('left');
    ui.button('Connect with note', () => prepareInvite());
    ui.button('Mark done', () => report('done', true));
    ui.button('Back', () => report('back', true));
    ui.button('Skip', () => report('skip', true));
    ui.keys([
      ['Alt+C', 'Connect with note'],
      ['Enter', 'Send, after checking the name'],
      ['Alt+X', 'Mark done in HubSpot'],
      ['Alt+B', 'Back to previous task'],
      ['Alt+S', 'Skip to next task'],
    ]);

    let job = null;
    let reported = false;
    let autoTimer = null;
    let current = null;
    let person = '';
    let redirected = false;
    let preparing = false;
    let retired = false;
    let limitSeen = '';

    const say = (tone, msg, next = '') => { if (!retired) ui.set(tone, msg, next); };

    // The newest helper tab wins; any older one steps aside.
    GM_setValue(KEY.claim, { id: TAB_ID, at: Date.now() });
    GM_addValueChangeListener(KEY.claim, (_k, _o, v, remote) => { if (remote && v && v.id !== TAB_ID) retire(); });
    function retire() {
      if (retired) return;
      ui.set('warn', 'Another LinkedIn tab took over', 'You can close this tab.');
      retired = true;
      job = null;
      clearTimeout(autoTimer);
      try { sessionStorage.removeItem('ptg_worker'); } catch (_) { /* ignore */ }
      if (window.name === WORKER_NAME) window.name = '';
    }

    const beat = () => { if (!retired) { GM_setValue(KEY.beat, { id: TAB_ID, at: Date.now() }); ui.keepAttached(); } };
    beat();
    setInterval(beat, 5000);
    GM_addValueChangeListener(KEY.ping, (_k, _o, v, remote) => {
      if (remote && v && !retired) GM_setValue(KEY.pong, { id: v.id, at: Date.now() });
    });

    // Show HubSpot's status here too, since this is the tab you're looking at.
    const showHs = (v) => { if (v && Date.now() - v.at < 30 * 60 * 1000) ui.mirror(v.tone, v.msg); };
    showHs(GM_getValue(KEY.hs, null));
    GM_addValueChangeListener(KEY.hs, (_k, _o, v) => showHs(v));

    /* ---------- page state ---------- */

    const onProfilePath = () => /^\/(in|pub)\//i.test(location.pathname);
    const blockedPage = () => /^\/(checkpoint|authwall|uas\/login|login|signup)/i.test(location.pathname);
    const pageMissing = () =>
      textNodes(document.querySelector('main') || document.body, (raw) =>
        /this page doesn.?t exist|page not found|profile (is )?(not available|unavailable)/i.test(raw)
      ).some(isVisible);

    function handleBlocked() {
      if (autoOn()) GM_setValue(KEY.auto, false);
      say('err', 'LinkedIn wants you to sign in or verify', 'Do that in this tab. Auto mode is off; turn it back on after.');
    }

    function noticeText() {
      return [...document.querySelectorAll('[role="dialog"], [role="alertdialog"], [role="alert"], [role="status"], [aria-live]')]
        .filter((d) => !ours(d) && isVisible(d))
        .map(textOf)
        .join(' ');
    }

    // LinkedIn's weekly limit warning stops everything and turns Auto off.
    function checkLimits() {
      if (retired) return false;
      const kind = limitKind(noticeText());
      if (!kind) return false;
      if (autoOn()) GM_setValue(KEY.auto, false);
      clearTimeout(autoTimer);
      if (kind === 'reached') {
        if (limitSeen !== 'reached' && job) {
          GM_setValue(KEY.result, { jobId: job.id, key: job.key, status: 'stop', at: Date.now() });
          reported = true;
        }
        limitSeen = 'reached';
        say('err', 'LinkedIn invite limit reached', 'Auto mode is off. Stop sending until LinkedIn resets your limit.');
        return true;
      }
      if (limitSeen === 'close') return false;
      limitSeen = 'close';
      say('warn', 'Close to LinkedIn’s weekly limit', 'Auto mode is off. Send by hand if you want, or stop for this week.');
      return true;
    }
    setInterval(() => { if (job && !retired) checkLimits(); }, 2000);

    /* ---------- reading the profile (top card only) ---------- */

    const SIDEBAR_HEAD = /^(more profiles for you|people you may know|people also viewed|other similar profiles|people similar to .+|you might like|explore premium profiles|pages for you|get expert advice on .+)$/i;

    // True for anything in the right-hand "More profiles for you" style boxes.
    function inSidebar(el, nameEl) {
      if (!el || !el.closest) return false;
      if (el.closest('aside, [role="complementary"]')) return true;
      for (let a = el.parentElement, i = 0; a && a !== document.body && i < 10; a = a.parentElement, i++) {
        if (nameEl && a.contains(nameEl)) return false;
        const h = a.querySelector('h2, h3');
        if (h && SIDEBAR_HEAD.test(textOf(h))) return true;
      }
      return false;
    }

    function nameFromPage() {
      const title = clean(document.title.replace(/^\(\d+\+?\)\s*/, '')).split(' | ')[0].trim();
      const root = document.querySelector('main') || document.body;
      if (title && !/^linkedin$/i.test(title)) {
        const el = textNodes(root, (raw) => clean(raw) === title).find((e) => isVisible(e) && !inSidebar(e));
        if (el) return { name: title, el };
      }
      const h1 = [...root.querySelectorAll('h1')].find((h) => isVisible(h) && !ours(h) && !inSidebar(h) && textOf(h) && textOf(h).length < 90);
      return h1 ? { name: textOf(h1), el: h1 } : null;
    }

    const ACTION_TEXT = /^(message|connect|follow|following|pending|more|save in sales navigator|view in sales navigator)$/i;
    const isAction = (b) => ACTION_TEXT.test(ownText(b)) || /more actions|to connect|^pending|^message|^follow/.test(ariaOf(b));

    // Smallest block around the name that also holds the action buttons (Message / Connect / … ).
    // Gives up rather than reaching the sidebar.
    function topCard(nameEl) {
      for (let el = nameEl.parentElement, i = 0; el && el !== document.body && i < 15; el = el.parentElement, i++) {
        if (el.querySelector('aside, [role="complementary"]')) return null;
        if ([...el.querySelectorAll('h2, h3')].some((h) => SIDEBAR_HEAD.test(textOf(h)))) return null;
        if ([...el.querySelectorAll('button, a, [role="button"]')].some((b) => !ours(b) && isAction(b) && isVisible(b))) return el;
      }
      return null;
    }

    const hasFirstDegree = (card) =>
      textNodes(card, (raw) => raw.includes('1st') && /^[·•]?\s*1st$|1st degree connection/i.test(clean(raw))).length > 0;

    const RELEVANT = /connect|invite|pending|withdraw|remove/i;
    function candidates(scope, nameEl) {
      return [...scope.querySelectorAll('button, a, [role="button"], [role="menuitem"], li, span, div[aria-label]')].filter((e) => {
        if (ours(e)) return false;
        const a = e.getAttribute('aria-label') || '';
        const t = e.textContent || '';
        if (!(RELEVANT.test(a) || (t.length <= 40 && RELEVANT.test(t)))) return false;
        return isVisible(e) && !inSidebar(e, nameEl);
      });
    }

    // strict = only trust elements that name this exact person (used for whole-page scans).
    function classify(els, ctx, strict) {
      let byAria = null;
      let byHref = null;
      let byText = null;
      const namesThem = (s) => !!ctx.full && normName(s).includes(ctx.full);
      for (const e of els) {
        const aria = ariaOf(e);
        const t = ownText(e).toLowerCase();
        const href = (e.getAttribute('href') || '').toLowerCase();
        if ((!strict && t === 'remove connection') || (/remove (your )?connection/.test(aria) && (!strict || namesThem(aria)))) {
          return { kind: 'connected' };
        }
        if ((!strict && t === 'pending') || ((/^pending\b/.test(aria) || /withdraw (the )?invitation/.test(aria)) && (!strict || namesThem(aria)))) {
          return { kind: 'pending' };
        }
        const invite = aria.match(/invite (.+?) to connect/);
        if (invite) { if (!byAria && (!strict || namesThem(invite[1]))) byAria = e; continue; }
        if (href.includes('custom-invite')) { if (!byHref && (!strict || (ctx.slug && href.includes(ctx.slug)))) byHref = e; continue; }
        if (!byText && !strict && t === 'connect') byText = e;
      }
      const connect = byAria || byHref || byText;
      return connect ? { kind: 'connect', el: actionable(connect) } : null;
    }

    // The … button. Usually labeled "More actions"; if not, it's the icon-only button in the
    // same row as Message / Follow / Save in Sales Navigator.
    function findMoreButton(card, nameEl) {
      const btns = [...card.querySelectorAll('button, [role="button"]')].filter((b) => !ours(b) && isVisible(b) && !inSidebar(b, nameEl));
      const hint = (b) => clean(`${hintsOf(b)} ${ownText(b).toLowerCase()}`);
      const seeMore = /(see|show|load|read) more/;
      const named =
        btns.find((b) => /(^|\s)more (actions|options)(\s|$)|overflow/.test(hint(b)) && !seeMore.test(hint(b))) ||
        btns.find((b) => /^more$/.test(hint(b))) ||
        btns.find((b) => /^(…|\.\.\.|⋯|•••)$/.test(ownText(b)));
      if (named) return named;
      const rows = btns.filter(isAction).map(rectOf);
      if (!rows.length) return null;
      const icons = btns
        .filter((b) => !isAction(b) && ownText(b).length <= 1 && !/notif|bell|close|dismiss|edit|camera|photo|cover/.test(hintsOf(b)))
        .map((b) => ({ b, r: rectOf(b) }))
        .filter(({ r }) => rows.some((a) => Math.abs((a.top + a.bottom) / 2 - (r.top + r.bottom) / 2) < 10 && r.left >= a.left))
        .sort((x, y) => y.r.left - x.r.left);
      return icons.length ? icons[0].b : null;
    }

    // Menu items sit just below (or above) the … button, never in the sidebar column.
    function nearMore(e, more) {
      const r = rectOf(e);
      const m = rectOf(more);
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      return cx >= m.left - 320 && cx <= m.right + 320 && cy >= m.top - 450 && cy <= m.bottom + 550;
    }

    function menuRoot(more) {
      const id = more.getAttribute('aria-controls');
      const byId = id && document.getElementById(id);
      if (byId && isVisible(byId) && !ours(byId)) return byId;
      return [...document.querySelectorAll('[role="menu"], [role="listbox"]')]
        .filter((m) => !ours(m) && isVisible(m) && nearMore(m, more))
        .pop() || null;
    }

    const MENUISH = /^(connect|follow|unfollow|remove connection|withdraw( invitation)?|pending|save to pdf|about this member|about this profile|send profile in a message|view in sales navigator|request a recommendation|recommend .{1,40}|report .{1,60}|block .{1,60}|share profile.*|copy link to profile|never an employee of my org)$/i;
    function menuish(more, nameEl) {
      return [...document.querySelectorAll('button, a, [role="button"], [role="menuitem"], [role="option"], li')].filter((e) => {
        if (ours(e) || (e.textContent || '').length > 70) return false;
        const a = e.getAttribute('aria-label') || '';
        if (!(MENUISH.test(ownText(e)) || /invite .+ to connect|remove (your )?connection|withdraw/i.test(a))) return false;
        return isVisible(e) && nearMore(e, more) && !inSidebar(e, nameEl);
      });
    }

    async function openMore(more, before, nameEl) {
      const isOpen = () =>
        more.getAttribute('aria-expanded') === 'true' || !!menuRoot(more) || menuish(more, nameEl).some((e) => !before.has(e));
      if (isOpen()) return true;
      return !!(await activate(more, isOpen, 900));
    }

    function closeMore(more) {
      if (!more) return;
      try { pressKey(document.activeElement || document.body, 'Escape'); } catch (_) { /* ignore */ }
      setTimeout(() => { if (more.isConnected && more.getAttribute('aria-expanded') === 'true') more.click(); }, 250);
    }

    // connected / pending / connect (top card first, then the … menu) / unknown
    async function detectStatus(who) {
      const card = topCard(who.el);
      if (!card) return { kind: 'unknown', reason: 'card' };
      const ctx = { full: normName(who.name), slug: slugOf(location.href) };
      if (hasFirstDegree(card)) return { kind: 'connected' };
      let st = classify(candidates(card, who.el), ctx, false);
      if (st) return st;

      const more = findMoreButton(card, who.el);
      if (!more) return classify(candidates(document.body, who.el), ctx, true) || { kind: 'unknown', reason: 'nomore' };

      const before = new Set(menuish(more, who.el)); // anything already on screen isn't part of the menu
      if (!(await openMore(more, before, who.el))) return { kind: 'unknown', reason: 'menu' };
      st = await waitFor(() => {
        const root = menuRoot(more);
        const fresh = menuish(more, who.el).filter((e) => !before.has(e));
        return (root && classify(candidates(root, who.el), ctx, false)) || classify(fresh, ctx, false) || classify(candidates(card, who.el), ctx, false);
      }, 3000);
      if (st && st.kind === 'connect') return { ...st, more };
      closeMore(more);
      return st || { kind: 'unknown', reason: 'nomenuconnect' };
    }

    function explainStatus(st) {
      if (st.kind === 'connected' || st.kind === 'pending') {
        say('ok', LABEL[st.kind], `${person}. Press Alt+X to complete in HubSpot.`);
        return;
      }
      const who = person || 'This person';
      const text = {
        card: ['Couldn’t find the profile’s buttons', 'Reload this tab (F5), or handle it by hand, then Alt+X or Alt+S.'],
        nomore: ['No Connect button or … menu', `${who}. Handle it by hand, then Alt+X (done) or Alt+S (skip).`],
        menu: ['The … menu didn’t open', 'Click … yourself, then press Alt+C.'],
        nomenuconnect: ['No Connect under the … menu', `${who} may only allow Follow. Handle it by hand, then Alt+X or Alt+S.`],
      }[st.reason] || ['No Connect option found', `${who}. Handle it by hand, then Alt+X (done) or Alt+S (skip).`];
      say('warn', text[0], text[1]);
    }

    /* ---------- invite window ---------- */

    const INVITE_TEXT = /add a note|invitation|invite|personali[sz]e|verify this member knows you|send without a note/i;
    const EMAIL_ASK = /enter (their|his|her|the member.?s) email|verify (that )?this member knows you/i;
    const dialogs = () => [...document.querySelectorAll('[role="dialog"], [role="alertdialog"]')].filter((d) => !ours(d) && isVisible(d));
    const inviteDialog = () => dialogs().filter((d) => INVITE_TEXT.test(textOf(d))).pop() || null;
    const quotaDialog = () => dialogs().find((d) => noteQuotaHit(textOf(d)) && !d.querySelector('textarea')) || null;
    const dialogButton = (d, re) =>
      d && [...d.querySelectorAll('button, [role="button"]')].find((b) => !ours(b) && isVisible(b) && (re.test(ownText(b)) || re.test(b.getAttribute('aria-label') || '')));
    const sendButton = (d) => dialogButton(d, /^send( invitation| now)?$/i);
    const textareaIn = (d) => (d ? [...d.querySelectorAll('textarea')].find(isVisible) || null : null);

    function emailInput(d) {
      if (!d) return null;
      const ins = [...d.querySelectorAll('input')].filter((i) => isVisible(i) && !/^(hidden|checkbox|radio|submit|button|search|file)$/i.test(i.type || ''));
      return (
        ins.find((i) => (i.type || '').toLowerCase() === 'email') ||
        ins.find((i) => /mail/i.test(`${i.name} ${i.id} ${i.getAttribute('aria-label') || ''} ${i.getAttribute('autocomplete') || ''} ${i.placeholder || ''}`)) ||
        (ins.length === 1 && EMAIL_ASK.test(textOf(d)) ? ins[0] : null)
      );
    }
    const needsEmail = (d) => !!d && (EMAIL_ASK.test(textOf(d)) || !!emailInput(d));

    async function prepareInvite() {
      if (preparing || retired) return;
      preparing = true;
      try {
        if (checkLimits()) return;
        let dlg = inviteDialog();
        if (!dlg) {
          let st = current;
          if (!st || st.kind !== 'connect' || !isVisible(st.el)) {
            const who = nameFromPage();
            if (!who || !topCard(who.el)) { say('warn', 'The profile hasn’t loaded yet', 'Wait a moment, then press Alt+C again.'); return; }
            person = who.name;
            say('work', 'Looking for Connect…', `${person}: checking the buttons and the … menu.`);
            st = await detectStatus(who);
            current = st;
          }
          if (st.kind !== 'connect') { explainStatus(st); return; }

          say('work', 'Opening the invite…', person);
          const got = await activate(st.el, () => inviteDialog() || quotaDialog() || (limitKind(noticeText()) ? 'limit' : null), 1500);
          if (checkLimits()) return;
          if (!got || got === 'limit') {
            try { GM_setClipboard(MESSAGE, 'text'); } catch (_) { /* ignore */ }
            say('warn', 'The invite window didn’t open', 'Click Connect yourself (it may be under …). The note is on your clipboard.');
            return;
          }
          dlg = inviteDialog() || got;
        }

        // 1) Email, when LinkedIn asks for it. This is the PROSPECT's email from HubSpot, never yours.
        const email = job && job.email && !isOwnEmail(job.email) ? job.email : '';
        if (needsEmail(dlg)) {
          const inp = emailInput(dlg);
          if (!email) {
            if (inp) inp.focus();
            say('warn', 'LinkedIn needs their email', `HubSpot has no email for ${person || 'this contact'}. Type their email (not yours), or Alt+S to skip.`);
            return;
          }
          if (inp) fillText(inp, email);
        }

        // 2) The note box.
        let box = textareaIn(dlg);
        let quota = false;
        if (!box) {
          const add = dialogButton(dlg, /^add a (free )?note$/i);
          if (add) {
            await sleep(150);
            add.click();
            const got = await waitFor(() => textareaIn(inviteDialog()) || (quotaDialog() ? 'quota' : null), 5000);
            if (got === 'quota') quota = true;
            else box = got;
          }
        }
        if (checkLimits()) return;
        if (!box) {
          try { GM_setClipboard(MESSAGE, 'text'); } catch (_) { /* ignore */ }
          if (quota || noteQuotaHit(noticeText())) {
            say('warn', 'No free notes left this month', 'LinkedIn won’t add a note right now. Send without a note, or Alt+S to skip.');
          } else {
            say('warn', 'The note box didn’t open', 'Click “Add a note” and paste with Ctrl+V, or Alt+S to skip.');
          }
          return;
        }

        // The window can redraw when the note box opens, so check the email again.
        const d2 = inviteDialog() || dlg;
        if (email && needsEmail(d2)) {
          const inp = emailInput(d2);
          if (inp && clean(inp.value).toLowerCase() !== email.toLowerCase()) fillText(inp, email);
        }
        fillText(box, MESSAGE);
        await sleep(250);

        const d3 = inviteDialog() || d2;
        if (clean(box.value) !== clean(MESSAGE)) {
          try { GM_setClipboard(MESSAGE, 'text'); } catch (_) { /* ignore */ }
          if (!box.value) say('warn', 'Couldn’t type the note', 'Click in the note box and paste with Ctrl+V.');
          else say('warn', 'The note didn’t fit', `LinkedIn kept ${box.value.length} characters. Fix it here, or shorten MESSAGE in the script.`);
          return;
        }
        const filledEmail = email && needsEmail(d3) ? email : '';
        const check = `Check it’s ${person || 'the right person'}${filledEmail ? ` (${filledEmail})` : ''}${redirected ? '. The link redirected' : ''}.`;
        const send = sendButton(d3);
        if (send && !isDisabled(send)) {
          send.focus();
          say('ok', 'Ready: press Enter to send', check);
        } else {
          say('warn', 'Send is greyed out', `${check} Fix what LinkedIn points out, then click Send.`);
        }
      } finally {
        preparing = false;
      }
    }

    // Your own click (or Enter) on Send is what completes the task in HubSpot.
    document.addEventListener('click', (e) => {
      if (retired || !job || reported) return;
      const b = e.target instanceof Element ? e.target.closest('button, [role="button"]') : null;
      if (!b || ours(b) || isDisabled(b)) return;
      const d = b.closest('[role="dialog"], [role="alertdialog"]');
      if (!d || !INVITE_TEXT.test(textOf(d))) return;
      if (!/\bsend\b/.test(`${ariaOf(b)} ${ownText(b).toLowerCase()}`)) return;
      afterSend(d);
    }, true);

    async function afterSend(d) {
      say('work', 'Sending…', '');
      const closed = await waitFor(() => !d.isConnected || !isVisible(d), 8000);
      await sleep(700);
      if (checkLimits()) return;
      if (!closed) {
        say('warn', 'The invite window is still open', 'Read LinkedIn’s message. If it sent, press Alt+X; if not, fix it or Alt+S.');
        return;
      }
      if (/couldn.?t send|wasn.?t sent|something went wrong|try again|incorrect email|valid email|doesn.?t match/i.test(noticeText())) {
        say('err', 'LinkedIn didn’t send the invite', 'Read LinkedIn’s message, then try again or Alt+S to skip.');
        return;
      }
      report('sent');
    }

    /* ---------- talking to HubSpot ---------- */

    function report(status, force, auto) {
      if (retired) return;
      if (!job) {
        say('warn', 'No HubSpot task yet', 'Start your task queue and press Alt+L there.');
        return;
      }
      if (reported && !force) return;
      reported = true;
      clearTimeout(autoTimer);
      autoTimer = null;
      GM_setValue(KEY.result, { jobId: job.id, key: job.key, status, auto: !!auto, at: Date.now() });
      if (status === 'back') {
        say('warn', 'Going back in HubSpot', 'Auto is paused. Press Alt+L in HubSpot to open that task here.');
        return;
      }
      say('ok', LABEL[status], autoOn() ? 'Updating HubSpot. The next profile will load here.' : 'Updating HubSpot. Press Alt+L there for the next one.');
    }

    async function start(j, isRedirect) {
      job = j;
      reported = false;
      current = null;
      person = '';
      redirected = !!isRedirect;
      limitSeen = '';
      clearTimeout(autoTimer);
      autoTimer = null;
      const tag = j.label ? `${j.label}: ` : '';

      if (blockedPage()) { handleBlocked(); return; }
      if (!onProfilePath()) {
        say('warn', `${tag}not a regular profile page`, 'Handle it by hand, then Alt+X (done) or Alt+S (skip).');
        return;
      }
      if (inviteDialog()) { say('ok', 'The invite window is open', 'Check it, then press Enter to send.'); return; }

      say('work', `${tag}reading the profile…`, '');
      const found = await waitFor(() => {
        if (pageMissing()) return { missing: true };
        const who = nameFromPage();
        return who && topCard(who.el) ? { who } : null;
      }, 15000);
      if (job !== j) return;
      if (!found) { say('err', 'The profile didn’t finish loading', 'Reload this tab (F5), or handle it by hand, then Alt+X or Alt+S.'); return; }
      if (found.missing) { say('warn', 'This LinkedIn link is broken', 'Fix the URL in HubSpot. For now, Alt+S to skip.'); return; }
      person = found.who.name;
      if (checkLimits()) return;
      await sleep(500); // let the rest of the buttons render

      const st = await detectStatus(nameFromPage() || found.who);
      if (job !== j) return;
      current = st;

      if (st.kind === 'connected' || st.kind === 'pending') {
        if (redirected) {
          say('warn', `${LABEL[st.kind]}, but the link redirected`, `Check this is the right person (${person}), then Alt+X to complete.`);
        } else if (autoOn()) {
          say('ok', LABEL[st.kind], `${person}. Completing in HubSpot…`);
          autoTimer = setTimeout(() => { if (job === j && autoOn()) report(st.kind, false, true); }, AUTO_COMPLETE_DELAY_MS);
        } else {
          say('ok', LABEL[st.kind], `${person}. Press Alt+X to complete in HubSpot.`);
        }
        return;
      }
      if (st.kind === 'connect') {
        if (redirected) {
          closeMore(st.more);
          say('warn', 'The link redirected to another profile', `Check this is the right person (${person}), then Alt+C to connect.`);
        } else if (autoOn()) {
          prepareInvite();
        } else {
          closeMore(st.more);
          say('ok', 'Not connected yet', `${person}. Press Alt+C to connect with the note.`);
        }
        return;
      }
      explainStatus(st);
    }

    GM_addValueChangeListener(KEY.job, (_k, _o, nj, remote) => {
      if (!remote || !nj || retired) return;
      setTimeout(() => {
        if (retired) return;
        if (nj.slug && slugOf(location.href) === nj.slug && onProfilePath()) {
          start(nj, false);
        } else {
          job = nj;
          say('work', `${nj.label ? `${nj.label}: ` : ''}opening the profile…`, '');
          location.href = nj.url;
        }
      }, 250);
    });

    GM_addValueChangeListener(KEY.auto, (_k, _o, on) => {
      if (on || retired || !autoTimer) return;
      clearTimeout(autoTimer);
      autoTimer = null;
      if (current && LABEL[current.kind]) say('ok', LABEL[current.kind], `${person}. Auto is off, so press Alt+X to complete in HubSpot.`);
    });

    hotkeys({
      KeyC: () => prepareInvite(),
      KeyX: () => report('done', true),
      KeyS: () => report('skip', true),
      KeyB: () => report('back', true),
    });

    // On page load, pick up the task HubSpot sent.
    if (blockedPage()) {
      handleBlocked();
    } else {
      const saved = GM_getValue(KEY.job, null);
      const here = slugOf(location.href);
      const fresh = saved && Date.now() - saved.at < 90000;
      if (saved && saved.slug && here === saved.slug) start(saved, false);
      else if (fresh && onProfilePath()) start(saved, true); // the link landed on a different profile
      else if (fresh && !saved.slug) start(saved, false);
      else say('ok', 'Waiting for HubSpot', 'Start your task queue in HubSpot and press Alt+L there.');
    }
  }

  /* ================================ BOOT =============================== */

  function onReady(fn) {
    if (document.body) fn();
    else document.addEventListener('DOMContentLoaded', fn, { once: true });
  }

  onReady(() => {
    if (ON_HUBSPOT) runHubSpot();
    else if (ON_LINKEDIN) runLinkedIn();
  });
})();
